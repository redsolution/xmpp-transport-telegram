[database]
url = postgresql://transport_user:transport_password@127.0.0.1:5432/xmpp_transport_telegram

[security]
# Generate with:
#   venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
session_encryption_key =

[xmpp]
component_jid = telegram.example.com
component_password = put-xmpp-component-secret-here
server_ip = 127.0.0.1
server_port = 5238
component_connect_timeout = 20
component_retry_interval = 10

[telegram]
# Create these at https://my.telegram.org/apps
api_id =
api_hash =
session_storage_dir = data/telegram_sessions

[transport]
# Optional. Defaults to example.com for component_jid=telegram.example.com.
server_domain = example.com
pid_file = run/xmpp_transport_telegram.pid
iq_auth_secret = put-a-long-random-secret-here

[server]
health_host = 127.0.0.1
health_port = 8089
qr_storage_dir = data/login_qr
# Public base URL for this transport HTTP listener. /qr/<file>.svg is appended.
qr_base_url = http://127.0.0.1:8089
# Remove generated login QR SVG files older than this age.
qr_max_age_seconds = 3600
qr_cleanup_interval_seconds = 3600
avatar_storage_dir = data/avatars
# Public base URL for this transport HTTP listener. /avatar/<hash>.jpg is appended.
avatar_base_url = http://127.0.0.1:8089
avatar_max_bytes = 524288
avatar_unreferenced_ttl_days = 7
avatar_cleanup_interval_seconds = 86400
media_base_url = http://127.0.0.1:8089
media_stream_request_size = 524288

[logging]
level = INFO
file = logs/xmpp_transport_telegram.log
max_bytes = 10485760
backup_count = 5
